{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment_defaultMode": "ロールアウト段階1〜3は acceptEdits（PR作成まで）。関門が実際に赤を出して止まることを確認してから段階4で dontAsk に切り替える。",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(src/**)",
      "Read(app/**)",
      "Read(lib/**)",
      "Read(tests/**)",
      "Read(package.json)",
      "Read(migrations/**)",
      "Edit(src/**)",
      "Edit(app/**)",
      "Edit(lib/**)",
      "Edit(tests/**)",
      "Edit(migrations/**)",
      "Bash(npm ci)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npx playwright install:*)",
      "Bash(node scripts/design-check.mjs:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git push origin feature/*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(curl -fsS:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(gh secret:*)",
      "Bash(gh repo delete:*)",
      "Bash(npm publish:*)",
      "Bash(vercel --prod:*)",
      "Bash(turso db destroy:*)",
      "Bash(curl:* -d :*)",
      "Bash(curl:* --data:*)",
      "Bash(*DROP TABLE*)",
      "Bash(*DROP COLUMN*)",
      "Bash(*TRUNCATE*)"
    ]
  }
}
